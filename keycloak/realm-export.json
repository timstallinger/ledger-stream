{
  "realm": "ledger-stream",
  "enabled": true,
  "displayName": "ledger-stream",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Read-only access to accounts and bookings (GET /api/v1/accounts/**)"
      },
      {
        "name": "writer",
        "description": "Create accounts, post bookings and cancel bookings (POST /api/v1/accounts/**)"
      },
      {
        "name": "operator",
        "description": "Operational admin access including DLQ inspection and replay (/admin/dlq/**)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ledger-stream-spa",
      "name": "ledger-stream Web UI (PKCE)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "ledger-stream-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "ledger-stream-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ledger-stream-cli",
      "name": "ledger-stream Test & CI CLI Client",
      "description": "TEST/CI INFRASTRUCTURE ONLY — directAccessGrantsEnabled is enabled solely for automated integration tests and local CLI smoke checks; interactive user logins exclusively use ledger-stream-spa (PKCE S256).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${LEDGER_CLI_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "ledger-stream-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "ledger-stream-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
