# Copy to .env for local docker compose usage and set non-empty values.
# Never commit .env with real secrets.
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=change-me-local-postgres-password

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-keycloak-admin
LEDGER_CLI_CLIENT_SECRET=change-me-local-cli-secret

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-grafana-password
