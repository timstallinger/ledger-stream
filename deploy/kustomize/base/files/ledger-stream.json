{
  "uid": "ledger-stream-overview",
  "title": "ledger-stream — Outbox, Consumer & DLQ Observability",
  "tags": ["ledger-stream", "kafka", "outbox", "dlq"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Outbox-Rückstand (PENDING)",
      "description": "Aktuelle Anzahl ungesendeter Outbox-Events (outbox_unsent).",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "outbox_unsent",
          "legendFormat": "PENDING"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 500 },
              { "color": "red", "value": 5000 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Outbox Oldest Pending Age (s) — 300s Alert-Schwelle",
      "description": "Alter des ältesten PENDING-Outbox-Events in Sekunden; rote Linie markiert die 300s-Alarmschwelle (OutboxRelayStalled).",
      "gridPos": { "h": 6, "w": 12, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "outbox_oldest_pending_age_seconds",
          "legendFormat": "oldest_pending_age_s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 300 }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "DLQ offen (Unhandled) & Replayed",
      "description": "Anzahl offener DLQ-Einträge (Zielwert 0) sowie kumulierte Replays.",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "dlq_entries_unhandled",
          "legendFormat": "DLQ offen"
        },
        {
          "refId": "B",
          "expr": "dlq_replayed_total",
          "legendFormat": "DLQ replayed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Durchsatz (Events/s)",
      "description": "Relay- und Consumer-Durchsatz in verarbeiteten Events pro Sekunde.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(outbox_events_relayed_total{result=\"success\"}[1m]))",
          "legendFormat": "Outbox Relayed /s"
        },
        {
          "refId": "B",
          "expr": "rate(consumer_processed_total{outcome=\"processed\"}[1m])",
          "legendFormat": "Consumer Processed /s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Consumer-Duplikate & Poison-Events",
      "description": "Echte Consumer-Duplikate (consumer_duplicates_rejected_total{reason=\"duplicate\"}) getrennt von Poison-Events (consumer_poison_total).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "consumer_duplicates_rejected_total{reason=\"duplicate\"}",
          "legendFormat": "duplicates"
        },
        {
          "refId": "B",
          "expr": "consumer_poison_total",
          "legendFormat": "poison"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Consumer-Fehlerrate, Retries & Outbox-Failures",
      "description": "Rate der Poison-Fehler, nicht-blockierenden Retries sowie dauerhaft fehlgeschlagenen Outbox-Events.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(consumer_processed_total{outcome=\"poison\"}[1m])",
          "legendFormat": "Consumer Poison /s"
        },
        {
          "refId": "B",
          "expr": "rate(consumer_retries_total[1m])",
          "legendFormat": "Consumer Retries /s"
        },
        {
          "refId": "C",
          "expr": "outbox_events_failed_total",
          "legendFormat": "Outbox FAILED total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP API Latenz (p95, ohne /actuator)",
      "description": "95. Perzentil der HTTP-Antwortzeiten pro API-URI (Actuator-Pfade ausgefiltert).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "p95 {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP API Latenz (p99, ohne /actuator)",
      "description": "99. Perzentil der HTTP-Antwortzeiten pro API-URI (Actuator-Pfade ausgefiltert).",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "p99 {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
